# Copy this file to ".env" (same folder) and set your own values. Never commit ".env".
MIMICIV_DB_USER=postgres
MIMICIV_DB_PASSWORD=change_me
MIMICIV_DB_HOST=localhost
MIMICIV_DB_PORT=5433
MIMICIV_DB_NAME=mimiciv

# Where Docker keeps the PostgreSQL files and where your uncompressed MIMIC-IV CSV files are
# (subfolders hosp/ and icu/). Absolute paths, or relative to the project root.
# On Windows use forward slashes, e.g. D:/mimic/postgres_data
MIMICIV_DATA_DIR=./postgres_data
MIMICIV_CSV_DIR=./mimic_csv
